    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: WHAT IS  WRONG WITH
      YOU!'
  - displayStartTime: 2.607
    displayEndTime: 3.107
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: YOU-YOU'
  - displayStartTime: 3.793
    displayEndTime: 4.686
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: YOU PSYCHO!'
  - displayStartTime: 6.001
    displayEndTime: 7.115
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: YOU DEGENERATE'
  - displayStartTime: 7.641
    displayEndTime: 8.636
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: AT THE OTHER END
      OF THAT CAMERA!'
  - displayStartTime: 9.158
    displayEndTime: 11
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: NOBODY WANTS TO BE
      HERE!'
  - displayStartTime: 11.782
    displayEndTime: 13.32
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: WHEN YOU OR WILL
      YOU PERISH?!?'
  - displayStartTime: 14.172
    displayEndTime: 15.697
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: JUST DIE ALREADY!'
  - displayStartTime: 15.909
    displayEndTime: 16.938
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: JUST DIE!'
  - displayStartTime: 16.979
    displayEndTime: 18.58
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: I AM NOT DOING THAT.'
  - displayStartTime: 19.283
    displayEndTime: 20.325
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: YOU CAN''T MAKE ME!'
  - displayStartTime: 22.4
    displayEndTime: 23.175
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: I DON''T CARE'
  - displayStartTime: 24.7
    displayEndTime: 25.2
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: NO.'
  - displayStartTime: 26.419
