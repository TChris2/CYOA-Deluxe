  - displayStartTime: 30.237
    displayEndTime: 30.737
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: Okay.'
  - displayStartTime: 30.883
    displayEndTime: 31.383
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: Alright.'
  - displayStartTime: 31.435
    displayEndTime: 31.935
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: That''s it!'
  - displayStartTime: 33.308
    displayEndTime: 34.669
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: IM GONNA PUT ON MY
      ASS KICKING BOOTS!'
  - displayStartTime: 35.824
    displayEndTime: 36.437
    text: '<style="Subtitles_Person_RT">RT</style>: What is-'
  - displayStartTime: 37.716
    displayEndTime: 39.242
    text: '<style="Subtitles_Person_RT">RT</style>: What is happening right now?'
  - displayStartTime: 40.233
    displayEndTime: 41.787
    text: '<style="Subtitles_Person_RT">RT</style>: Do-Do you want to explain this?'
  - displayStartTime: 47.724
    displayEndTime: 48.964
    text: '<style="Subtitles_Person_RT">RT</style>: NO! NO! NO!'
  - displayStartTime: 48.964
    displayEndTime: 49.668
    text: '<style="Subtitles_Person_RT">RT</style>: I''m not playing anymore.'
  - displayStartTime: 49.668
    displayEndTime: 50.528
    text: '<style="Subtitles_Person_RT">RT</style>: I''m not playing with you!'
  - displayStartTime: 50.528
    displayEndTime: 51.144
    text: '<style="Subtitles_Person_RT">RT</style>: This is WRONG!'
  - displayStartTime: 51.47
    displayEndTime: 52.259
    text: '<style="Subtitles_Person_RT">RT</style>: This is SICK!'
