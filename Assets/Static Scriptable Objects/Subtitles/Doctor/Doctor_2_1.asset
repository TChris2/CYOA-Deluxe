    displayEndTime: 12.773
    text: '<style="Subtitles_Person_RT">RT</style>: We can get it'
  - displayStartTime: 14.326
    displayEndTime: 15.269
    text: '<style="Subtitles_Person_RT">RT</style>: UNDER CONTROL!'
  - displayStartTime: 20.371
    displayEndTime: 20.871
    text: '<style="Subtitles_Person_RT">RT</style>: The Tardis!'
  - displayStartTime: 23.954
    displayEndTime: 25.734
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: Oh, you wanna fight?'
  - displayStartTime: 26.303
    displayEndTime: 27.191
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: You wanna fight?'
  - displayStartTime: 27.191
    displayEndTime: 28.244
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: You don''t wanna
      mess with me!'
  - displayStartTime: 29.001
    displayEndTime: 29.707
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: Y O U  W A N N A 
