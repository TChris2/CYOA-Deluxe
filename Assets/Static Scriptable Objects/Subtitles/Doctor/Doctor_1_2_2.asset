  subtitleEntries:
  - displayStartTime: 0.83
    displayEndTime: 1.662
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: Just west of London!'
  - displayStartTime: 3.681
    displayEndTime: 4.181
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: Hang on!'
  - displayStartTime: 4.522
    displayEndTime: 6.302
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: It is a bit of a
      bumpy ride the first time!'
  - displayStartTime: 10.714
    displayEndTime: 12.232
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: Specify the singularity..

      <style="Subtitles_Person_RT">RT</style>:
      OHHH MY GAWD'
  - displayStartTime: 16.673
    displayEndTime: 17.596
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: ...under control!'
  - displayStartTime: 23.705
    displayEndTime: 24.205
    text: '<style="Subtitles_Person_Doctor">The Doctor</style>: OH,'
  - displayStartTime: 31.6
    displayEndTime: 33.811
    text: '<style="Subtitles_Person_EvilRT">Evil RT</style>: I expect you to die!'
  - displayStartTime: 34.914
    displayEndTime: 36.18
    text: '<style="Subtitles_Person_RT">RT</style> & <style="Subtitles_Person_Doctor">The
      Doctor</style>: NO! NO! NO!'
  - displayStartTime: 40.103
    displayEndTime: 41.573
    text: '<style="Complete">Gold RT</style>: WOULD YOU <style="YOUTUBE"></style>
      KEEP IT DOWN THERE?!?'
  - displayStartTime: 42.702
    displayEndTime: 43.373
    text: '<style="Complete">Gold RT</style>: BE QUIET!'
  - displayStartTime: 43.373
    displayEndTime: 44.768
    text: '<style="Complete">Gold RT</style>: Sorry, sorry chat.'
