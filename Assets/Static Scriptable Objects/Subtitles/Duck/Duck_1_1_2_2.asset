    displayEndTime: 46.955
    text: <style="Subtitles_Format_()">Magical Woosh</style>
  - displayStartTime: 47.82
    displayEndTime: 48.52
    text: '<style="Subtitles_Format_()">Crumbling Rocks</style> '
  - displayStartTime: 48.52
    displayEndTime: 51.443
    text: <style="Subtitles_Format_[]">Door Sliding</style>
  - displayStartTime: 52.16
    displayEndTime: 54.55
    text: <style="Subtitles_Format_()">Angelic Choir ft. Duck Sounds</style>
  - displayStartTime: 54.55
    displayEndTime: 55.65
    text: '<style="Subtitles_Person_RT">RT</style>: Oh my God.'
  - displayStartTime: 56.55
    displayEndTime: 58.429
    text: '<style="Subtitles_Person_RT">RT</style>: Oh my God it''s here!'
  - displayStartTime: 59.68
    displayEndTime: 62.491
    text: '<style="Subtitles_Person_RT">RT</style>: Oh I can''t believe this!'
  - displayStartTime: 66
    displayEndTime: 68.021
    text: '<style="Subtitles_Person_RT">RT</style>: You''ve really done something
      here.'
  - displayStartTime: 69.065
    displayEndTime: 70.939
    text: '<style="Subtitles_Person_RT">RT</style>: This is incredible'
  - displayStartTime: 72.44
    displayEndTime: 76.596
    text: '<style="Subtitles_Person_RT">RT</style>: This is for you! This is for
      you.'
  - displayStartTime: 76.874
    displayEndTime: 78.874
    text: '<style="Subtitles_Person_RT">RT</style>: You''ve earned this!'
