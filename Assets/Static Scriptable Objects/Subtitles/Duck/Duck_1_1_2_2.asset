  subtitleEntries:
  - displayStartTime: 0.84
    displayEndTime: 2.95
    text: '<style="Subtitles_Person_RT">Positive RT</style>: Don''t let your mind
      hold you back!'
  - displayStartTime: 3.55
    displayEndTime: 6
    text: '<style="Subtitles_Person_RT">Positive RT</style>: You can do this, I have
      faith in you.'
  - displayStartTime: 7.273
    displayEndTime: 10.147
    text: '<style="Subtitles_Person_RT">RT</style>: I could be the most magical man
      you ever see today.'
  - displayStartTime: 10.982
    displayEndTime: 12.25
    text: '<style="Subtitles_Person_RT">RT</style>: I can perform magic.'
  - displayStartTime: 13.05
    displayEndTime: 15.224
    text: '<style="Subtitles_Person_RT">RT</style>: You want to see a magic trick?'
  - displayStartTime: 16.372
    displayEndTime: 17.696
    text: '<style="Subtitles_Person_RT">RT</style>: Watch me disappear!'
  - displayStartTime: 19.401
    displayEndTime: 20.045
    text: <style="Subtitles_Format_[]">Mario Jump</style>
  - displayStartTime: 21.36
    displayEndTime: 21.86
    text: <style="Subtitles_Format_()">Irish Fall SFX</style>
  - displayStartTime: 25.44
    displayEndTime: 27.574
    text: '<style="Subtitles_Person_RT">RT</style>: Let me just take the helm here.'
  - displayStartTime: 27.574
    displayEndTime: 30.197
    text: '<style="Subtitles_Person_RT">RT</style>: You want to fight?! You don''t
      want to mess with me.'
  - displayStartTime: 30.615
    displayEndTime: 32.906
    text: <style="Subtitles_Format_()">Stones Crunching</style>
  - displayStartTime: 44.536
    displayEndTime: 45.723
