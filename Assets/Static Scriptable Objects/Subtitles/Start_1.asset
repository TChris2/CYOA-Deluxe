  - displayStartTime: 18.581
    displayEndTime: 20.131
    text: '<style="Subtitles_Person_RT">RT</style>: I know where you live.'
  - displayStartTime: 21.454
    displayEndTime: 22.301
    text: <style="Subtitles_Format_()">Engine Rev</style>
  - displayStartTime: 35.428
    displayEndTime: 36.258
    text: <style="Subtitles_Format_()">Clock Breaks</style>
  - displayStartTime: 52
    displayEndTime: 56
    text: <style="Subtitles_Person_SubtitlesGuy">Both me and Cab want to thank every
      single editor, artist and clip provider for the help with this project... Thank
      you!</style>
  - displayStartTime: 64
    displayEndTime: 68.5
    text: '<style="Subtitles_Person_RT">RT</style>: Anywhere in time and space, and
      we don''t kill.'
  - displayStartTime: 70.4
    displayEndTime: 71.8
    text: '<style="Subtitles_Person_RT">RT</style>: And I don''t want to break that
      rule.

      <style="Subtitles_Person_SubtitlesGuy">Enjoy the show!</style>'
