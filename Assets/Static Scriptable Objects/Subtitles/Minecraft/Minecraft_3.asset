  subtitleEntries:
  - displayStartTime: 1.587
    displayEndTime: 3.221
    text: '<style="Subtitles_Person_RT">RT</style>: We need to build!'
  - displayStartTime: 6.038
    displayEndTime: 8
    text: '<style="Subtitles_Person_RT">RT</style>: ...y''know, we''re gonna be moving
