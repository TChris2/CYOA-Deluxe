  - displayStartTime: 14.307
    displayEndTime: 15.892
    text: '<style="Subtitles_Person_RT">RT</style>: That''s fantastic!'
  - displayStartTime: 16.543
    displayEndTime: 18.543
    text: '<style="Subtitles_Person_RT">RT</style>: Wow, I really gotta hand it to
      ya.'
  - displayStartTime: 18.952
    displayEndTime: 22.128
    text: '<style="Subtitles_Person_RT">RT</style>: That''s my boy! Oh, that''s my
      boy!'
  - displayStartTime: 22.128
    displayEndTime: 24.128
    text: '<style="Subtitles_Person_RT">RT</style>: Oh, I''m so proud of you!'
  - displayStartTime: 26.512
    displayEndTime: 27.647
    text: '<style="Subtitles_Person_RT">RT</style>: No.'
  - displayStartTime: 28.346
    displayEndTime: 29.308
    text: '<style="Subtitles_Person_RT">RT</style>: No.'
  - displayStartTime: 35.689
    displayEndTime: 38.312
    text: '<style="Subtitles_Person_RT">RT</style>: Uh... Where is the spatula gone?'
  - displayStartTime: 38.312
    displayEndTime: 38.859
    text: '<style="Subtitles_Person_RT">RT</style>: HEUAGH!'
  - displayStartTime: 41.183
